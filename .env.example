# Copy to .env and fill in. Never commit .env.

# --- LLM -------------------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
# Used for resume extraction, shortlisting, the live screening agent and transcript parsing.
GEMINI_API_KEY=

# --- Email (Gmail SMTP) -----------------------------------------------------
# SMTP_PASS must be a Gmail *app password*: Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASS=
# Sender shown to candidates (defaults to SMTP_USER)
EMAIL_FROM_ADDRESS=
# Optional: EMAIL_MODE=outbox writes emails to data/outbox/*.eml instead of sending
# EMAIL_MODE=

# --- Storage (MongoDB) -------------------------------------------------------
# Local server: mongodb://localhost:27017   ·   Atlas: mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=recruiting_screening
# Optional: force a backend for every command (file | mongodb). Default: storage.backend in settings.yaml
# STORAGE_BACKEND=
