{
  "$defs": {
    "CandidateEntry": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "source_file": {
          "title": "Source File",
          "type": "string"
        },
        "source_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Sha256"
        },
        "ingested_at": {
          "title": "Ingested At",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "current_stage": {
          "default": "stage1_extraction",
          "enum": [
            "stage1_extraction",
            "stage2_shortlisting",
            "stage3_calling",
            "stage4_evaluation"
          ],
          "title": "Current Stage",
          "type": "string"
        },
        "overall_status": {
          "default": "active",
          "enum": [
            "active",
            "rejected",
            "failed",
            "awaiting",
            "completed",
            "evaluated",
            "selected",
            "not_selected"
          ],
          "title": "Overall Status",
          "type": "string"
        },
        "stages": {
          "additionalProperties": {
            "$ref": "#/$defs/StageState"
          },
          "propertyNames": {
            "enum": [
              "stage1_extraction",
              "stage2_shortlisting",
              "stage3_calling",
              "stage4_evaluation"
            ]
          },
          "title": "Stages",
          "type": "object"
        },
        "reviews": {
          "additionalProperties": {
            "$ref": "#/$defs/Review"
          },
          "propertyNames": {
            "enum": [
              "shortlist",
              "final"
            ]
          },
          "title": "Reviews",
          "type": "object"
        },
        "notifications": {
          "additionalProperties": {
            "$ref": "#/$defs/Notification"
          },
          "propertyNames": {
            "enum": [
              "shortlist",
              "final"
            ]
          },
          "title": "Notifications",
          "type": "object"
        }
      },
      "required": [
        "candidate_id",
        "source_file",
        "source_sha256",
        "ingested_at",
        "updated_at"
      ],
      "title": "CandidateEntry",
      "type": "object"
    },
    "Notification": {
      "additionalProperties": false,
      "description": "A result email to the candidate (approvals.py).",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "sent",
            "outbox",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To"
        },
        "at": {
          "title": "At",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "kind",
        "status",
        "at"
      ],
      "title": "Notification",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "description": "A person's decision at an approval gate (approvals.py).",
      "properties": {
        "decision": {
          "enum": [
            "shortlisted",
            "rejected"
          ],
          "title": "Decision",
          "type": "string"
        },
        "ai_decision": {
          "anyOf": [
            {
              "enum": [
                "shortlisted",
                "rejected"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ai Decision"
        },
        "by": {
          "title": "By",
          "type": "string"
        },
        "at": {
          "title": "At",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "decision",
        "by",
        "at"
      ],
      "title": "Review",
      "type": "object"
    },
    "StageState": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "success",
            "failed",
            "skipped",
            "awaiting"
          ],
          "title": "Status",
          "type": "string"
        },
        "output_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Path"
        },
        "updated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "decision": {
          "anyOf": [
            {
              "enum": [
                "shortlisted",
                "rejected"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        }
      },
      "title": "StageState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    },
    "candidates": {
      "additionalProperties": {
        "$ref": "#/$defs/CandidateEntry"
      },
      "title": "Candidates",
      "type": "object"
    }
  },
  "title": "CandidatesIndexDoc",
  "type": "object"
}
